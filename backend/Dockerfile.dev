# Build stage
FROM gradle:jdk21 AS builder

WORKDIR /app

COPY backend/build.gradle ./
COPY backend/src ./src
COPY backend/gradle ./gradle

# Download dependencies
RUN gradle build --no-daemon -x test --continue 2>/dev/null || true

# Run stage
FROM gradle:jdk21

WORKDIR /app

# Copy source and gradle files
COPY backend/build.gradle ./
COPY backend/src ./src
COPY backend/gradle ./gradle

# Copy cached dependencies from builder
COPY --from=builder /home/gradle/.gradle /home/gradle/.gradle

EXPOSE 8080

# Run with hot reload via Spring DevTools
CMD ["gradle", "bootRun", "--no-daemon"]
